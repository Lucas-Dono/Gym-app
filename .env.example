# Clave de OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-...

# Contraseña para entrar a la app (recomendado si la publicas en internet)
APP_PASSWORD=

# Opcional: modelos a probar en orden, separados por coma.
# Por defecto: modelos gratuitos y, como respaldo, anthropic/claude-haiku-5.5 (muy barato).
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free,anthropic/claude-haiku-5.5

# Opcional: "off" desactiva la búsqueda web del video (cuesta ~US$0,02 la primera vez que abres cada ejercicio)
# VIDEO_SEARCH=off
